<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/PawnKindDef[defName="ESCP_Pawnkind_Dunmer_Melee" or defName="ESCP_Pawnkind_Dunmer_Ranged"]/apparelTags</xpath>
        <value>
            <li>ESCP_Dunmer_Chitin</li>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/PawnKindDef[defName="ESCP_Pawnkind_Dunmer_Captain"]/apparelTags</xpath>
        <value>
            <li>ESCP_Dunmer_Chitin</li>
            <li>ESCP_Dunmer_Bonemold</li>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/PawnKindDef[defName="ESCP_Pawnkind_Dunmer_Elite" or defName="ESCP_Unique_Pawnkind_Dunmer_Archmaster" or defName="ESCP_Unique_Pawnkind_Dunmer_Master"]/apparelTags</xpath>
        <value>
            <li>ESCP_Dunmer_Bonemold</li>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/TraderKindDef[defName="ESCP_Caravan_Dunmer_Trader"]/stockGenerators</xpath>
        <value>
            <li Class="StockGenerator_SingleDef">
                <thingDef>InsectJelly</thingDef>
                <countRange>40~100</countRange>
            </li>
        </value>
    </Operation>

</Patch>
