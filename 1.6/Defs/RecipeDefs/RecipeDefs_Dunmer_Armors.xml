<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <RecipeDef>
        <defName>ESCP_Recipe_Make_Dunmer_Chitin_Cuirass</defName>
        <label>make chitin cuirass</label>
        <description>Cut and lacquer insect shell into overlapping plates, then stitch them to a leather backing.</description>
        <jobString>Stitching chitin cuirass.</jobString>
        <workAmount>7000</workAmount>
        <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
        <workSkill>Crafting</workSkill>
        <effectWorking>Tailor</effectWorking>
        <soundWorking>Recipe_Tailor</soundWorking>
        <unfinishedThingDef>UnfinishedApparel</unfinishedThingDef>
        <recipeUsers>
            <li>HandTailoringBench</li>
            <li>ElectricTailoringBench</li>
        </recipeUsers>
        <ingredients>
            <li>
                <filter>
                    <categories>
                        <li>Leathers</li>
                    </categories>
                </filter>
                <count>20</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>ESCP_Item_Chitin</li>
                    </thingDefs>
                </filter>
                <count>40</count>
            </li>
        </ingredients>
        <fixedIngredientFilter>
            <categories>
                <li>Leathers</li>
            </categories>
            <thingDefs>
                <li>ESCP_Item_Chitin</li>
            </thingDefs>
        </fixedIngredientFilter>
        <products>
            <ESCP_Apparel_Dunmer_Chitin_Cuirass>1</ESCP_Apparel_Dunmer_Chitin_Cuirass>
        </products>
        <skillRequirements>
            <Crafting>4</Crafting>
        </skillRequirements>
        <researchPrerequisite>ESCP_Research_Dunmer_Chitin</researchPrerequisite>
        <modExtensions>
            <li Class="ESCP.Crafting.RecipeExtension_XenotypeCheck">
                <requireXenotype>ESCP_Xenotype_Dunmer</requireXenotype>
            </li>
        </modExtensions>
    </RecipeDef>

